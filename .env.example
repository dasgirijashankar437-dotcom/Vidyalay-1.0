# Copy to .env.local for local development; never commit .env.local.
# Values come from your own Supabase project dashboard.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only secrets belong in Supabase Edge Function Secrets, not this file or browser code.
# Never put SUPABASE_SECRET_KEY, service_role keys, WhatsApp tokens, or Telegram bot tokens here in a committed file.
